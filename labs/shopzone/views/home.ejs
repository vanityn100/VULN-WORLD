<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-width=1.0">
  <title>ShopZone - Tech Electronics</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-gray-50 text-gray-800 font-sans">
  
  <!-- Navbar -->
  <nav class="bg-blue-700 text-white shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16 items-center">
        <div class="flex-shrink-0 flex items-center">
          <i class="fas fa-shopping-bag text-2xl mr-2"></i>
          <span class="font-bold text-xl tracking-wider">ShopZone</span>
        </div>
        <div class="flex space-x-6 items-center">
          <span class="text-sm font-medium">
            <i class="fas fa-wallet mr-1 text-blue-200"></i> Account Balance: 
            <span class="font-bold text-green-300">$<%= shopzone.balance %></span>
          </span>
          <form action="/labs/shopzone/reset" method="POST" class="inline">
            <button type="submit" class="text-sm text-blue-200 hover:text-white transition">Sign Out / Reset</button>
          </form>
        </div>
      </div>
    </div>
  </nav>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <% if (shopzone.completed) { %>
      <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-8 shadow-sm rounded flex items-center">
        <i class="fas fa-check-circle text-2xl mr-3"></i>
        <div>
          <h3 class="font-bold">Order Confirmed (Lab Completed!)</h3>
          <p class="text-sm">You have successfully exploited the business logic flaw to bypass payment constraints.</p>
        </div>
      </div>
    <% } %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Product Listing -->
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold mb-6 text-gray-800 border-b pb-2">Featured Products</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- Product 1 -->
          <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition">
            <div class="h-48 bg-gray-200 flex items-center justify-center text-gray-400">
              <i class="fas fa-headphones text-6xl"></i>
            </div>
            <div class="p-5">
              <div class="flex justify-between items-start mb-2">
                <h3 class="text-lg font-bold text-gray-900">Noise-Cancelling Headphones</h3>
                <span class="text-lg font-bold text-blue-600">$150</span>
              </div>
              <p class="text-gray-500 text-sm mb-4">Premium wireless headphones with active noise cancellation and 30-hour battery life.</p>
              
              <form action="/labs/shopzone/cart/add" method="POST" class="flex items-center space-x-2">
                <input type="hidden" name="id" value="101">
                <input type="hidden" name="name" value="Noise-Cancelling Headphones">
                <input type="hidden" name="price" value="150">
                <select name="quantity" class="border border-gray-300 rounded-md p-2 text-sm focus:ring-blue-500 focus:border-blue-500">
                  <option value="1">1</option>
                  <option value="2">2</option>
                  <option value="3">3</option>
                </select>
                <button type="submit" class="flex-1 bg-gray-900 text-white py-2 px-4 rounded-md hover:bg-gray-800 transition font-medium text-sm flex justify-center items-center">
                  <i class="fas fa-cart-plus mr-2"></i> Add to Cart
                </button>
              </form>
            </div>
          </div>

          <!-- Product 2 -->
          <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition">
            <div class="h-48 bg-gray-200 flex items-center justify-center text-gray-400">
              <i class="fas fa-laptop text-6xl"></i>
            </div>
            <div class="p-5">
              <div class="flex justify-between items-start mb-2">
                <h3 class="text-lg font-bold text-gray-900">ProBook X14</h3>
                <span class="text-lg font-bold text-blue-600">$1,299</span>
              </div>
              <p class="text-gray-500 text-sm mb-4">Ultra-slim laptop ideal for professionals. 16GB RAM, 512GB SSD, Retina display.</p>
              
              <form action="/labs/shopzone/cart/add" method="POST" class="flex items-center space-x-2">
                <input type="hidden" name="id" value="102">
                <input type="hidden" name="name" value="ProBook X14">
                <input type="hidden" name="price" value="1299">
                <select name="quantity" class="border border-gray-300 rounded-md p-2 text-sm focus:ring-blue-500 focus:border-blue-500">
                  <option value="1">1</option>
                  <option value="2">2</option>
                  <option value="3">3</option>
                </select>
                <button type="submit" class="flex-1 bg-gray-900 text-white py-2 px-4 rounded-md hover:bg-gray-800 transition font-medium text-sm flex justify-center items-center">
                  <i class="fas fa-cart-plus mr-2"></i> Add to Cart
                </button>
              </form>
            </div>
          </div>

        </div>
      </div>

      <!-- Shopping Cart Summary -->
      <div class="lg:col-span-1">
        <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6 sticky top-6">
          <h2 class="text-xl font-bold mb-4 text-gray-800 border-b pb-2 flex items-center">
            <i class="fas fa-shopping-cart mr-2"></i> Order Summary
          </h2>
          
          <% if (shopzone.cart && shopzone.cart.length > 0) { %>
            <div class="space-y-4 mb-6">
              <% let subtotal = 0; %>
              <% shopzone.cart.forEach((item, index) => { %>
                <% let itemTotal = item.price * item.quantity; %>
                <% subtotal += itemTotal; %>
                <div class="flex justify-between items-start text-sm">
                  <div>
                    <p class="font-medium text-gray-900"><%= item.name %></p>
                    <p class="text-gray-500">Qty: <%= item.quantity %></p>
                  </div>
                  <p class="font-medium text-gray-900">$<%= itemTotal %></p>
                </div>
              <% }) %>
            </div>
            
            <div class="border-t pt-4 space-y-2 mb-6">
              <div class="flex justify-between text-sm">
                <span class="text-gray-600">Subtotal</span>
                <span class="font-medium">$<%= subtotal %></span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-gray-600">Tax & Shipping</span>
                <span class="text-green-600 font-medium">Free</span>
              </div>
              <div class="flex justify-between text-lg font-bold pt-2 border-t mt-2">
                <span>Total</span>
                <span>$<%= subtotal %></span>
              </div>
            </div>

            <form action="/labs/shopzone/checkout" method="POST">
              <button type="submit" class="w-full bg-blue-600 text-white py-3 px-4 rounded-md hover:bg-blue-700 transition font-bold text-lg shadow-sm">
                Complete Checkout
              </button>
            </form>
            
            <% if (subtotal > shopzone.balance) { %>
              <p class="text-red-500 text-xs mt-3 text-center"><i class="fas fa-exclamation-triangle"></i> Insufficient funds for checkout.</p>
            <% } %>

          <% } else { %>
            <div class="text-center py-8 text-gray-400">
              <i class="fas fa-box-open text-4xl mb-3"></i>
              <p>Your cart is empty.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
    
    <div class="mt-16">
      <%- include('../../../views/partials/helper', { labHints, labObjective }) %>
    </div>
  </main>
  
</body>
</html>