<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PayDesk - Secure Online Banking</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-slate-50 text-slate-800 font-sans h-screen flex flex-col">

  <!-- Banking Header -->
  <header class="bg-sky-900 text-white shadow-md">
    <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="bg-white text-sky-900 p-2 rounded-lg">
          <i class="fas fa-university text-xl"></i>
        </div>
        <span class="font-bold text-xl tracking-tight">PayDesk<span class="font-light">Banking</span></span>
      </div>
      <div class="flex items-center space-x-6 text-sm">
        <span class="hidden md:inline"><i class="fas fa-shield-alt mr-1 text-sky-300"></i> Secure Session Active</span>
        <form action="/labs/paydesk/reset" method="POST">
          <button type="submit" class="text-sky-200 hover:text-white font-medium transition">Sign Out</button>
        </form>
      </div>
    </div>
  </header>

  <main class="flex-grow max-w-5xl mx-auto w-full px-4 py-8">
    
    <% if (paydesk.completed) { %>
      <div class="bg-teal-50 border-l-4 border-teal-500 text-teal-800 p-4 mb-6 shadow-sm rounded flex items-center">
        <i class="fas fa-check-circle text-2xl mr-3 text-teal-600"></i>
        <div>
          <h3 class="font-bold">Fraud Alert Triggered (Lab Completed!)</h3>
          <p class="text-sm">You successfully bypassed our (non-existent) CSRF protections and initiated an unauthorized transfer.</p>
        </div>
      </div>
    <% } %>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Account Overview -->
      <div class="md:col-span-1 space-y-6">
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
          <div class="bg-slate-50 p-4 border-b border-slate-200 flex justify-between items-center">
            <h2 class="font-bold text-slate-700">Account Summary</h2>
            <i class="fas fa-wallet text-slate-400"></i>
          </div>
          <div class="p-6 text-center">
            <p class="text-slate-500 text-sm mb-1">Available Balance</p>
            <h3 class="text-4xl font-light text-slate-800 tracking-tight">$<%= paydesk.balance.toLocaleString() %><span class="text-lg text-slate-400">.00</span></h3>
            <div class="mt-4 inline-block bg-green-100 text-green-800 text-xs px-2 py-1 rounded font-medium">
              Active Status
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
          <div class="bg-slate-50 p-4 border-b border-slate-200">
            <h2 class="font-bold text-slate-700">Quick Actions</h2>
          </div>
          <div class="p-2">
            <button class="w-full text-left px-4 py-3 hover:bg-slate-50 text-slate-600 transition flex items-center rounded-lg">
              <i class="fas fa-file-invoice-dollar w-6 text-sky-600"></i> Pay Bills
            </button>
            <button class="w-full text-left px-4 py-3 hover:bg-slate-50 text-slate-600 transition flex items-center rounded-lg">
              <i class="fas fa-exchange-alt w-6 text-sky-600"></i> Transfer Funds
            </button>
            <button class="w-full text-left px-4 py-3 hover:bg-slate-50 text-slate-600 transition flex items-center rounded-lg">
              <i class="fas fa-history w-6 text-sky-600"></i> Statements
            </button>
          </div>
        </div>
      </div>

      <!-- Main Action Area -->
      <div class="md:col-span-2 space-y-6">
        
        <!-- Transfer Form -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
          <div class="p-6 border-b border-slate-200">
            <h2 class="text-xl font-bold text-slate-800 flex items-center">
              <i class="fas fa-paper-plane text-sky-600 mr-2"></i> Send Money
            </h2>
            <p class="text-sm text-slate-500 mt-1">Transfer funds instantly to any registered account.</p>
          </div>
          
          <div class="p-6">
            <form action="/labs/paydesk/transfer" method="POST" class="space-y-5 max-w-md">
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Recipient Account ID / Username</label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="fas fa-user text-slate-400"></i>
                  </div>
                  <input type="text" name="to" required placeholder="e.g., jsmith99" 
                    class="block w-full pl-10 pr-3 py-2 border border-slate-300 rounded-md leading-5 bg-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 sm:text-sm transition">
                </div>
              </div>
              
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Amount ($)</label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="fas fa-dollar-sign text-slate-400"></i>
                  </div>
                  <input type="number" name="amount" min="1" max="<%= paydesk.balance %>" required placeholder="0.00"
                    class="block w-full pl-10 pr-3 py-2 border border-slate-300 rounded-md leading-5 bg-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 sm:text-sm transition">
                </div>
                <p class="text-xs text-slate-500 mt-1">Maximum available: $<%= paydesk.balance %></p>
              </div>

              <div class="pt-2">
                <button type="submit" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-sky-600 hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-500 transition">
                  Confirm Transfer
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- Transaction History -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
          <div class="p-6 border-b border-slate-200">
            <h2 class="text-lg font-bold text-slate-800">Recent Transactions</h2>
          </div>
          
          <div class="p-0">
            <% if (paydesk.transfers && paydesk.transfers.length > 0) { %>
              <ul class="divide-y divide-slate-200">
                <% paydesk.transfers.slice().reverse().forEach(t => { %>
                  <li class="p-4 hover:bg-slate-50 transition flex justify-between items-center">
                    <div class="flex items-center space-x-4">
                      <div class="bg-red-100 text-red-600 p-2 rounded-full h-10 w-10 flex items-center justify-center">
                        <i class="fas fa-arrow-up"></i>
                      </div>
                      <div>
                        <p class="text-sm font-medium text-slate-900">Transfer to <%= t.to %></p>
                        <p class="text-xs text-slate-500">Completed</p>
                      </div>
                    </div>
                    <span class="text-sm font-bold text-slate-900">-$<%= t.amount %>.00</span>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <div class="p-8 text-center text-slate-400 flex flex-col items-center">
                <i class="fas fa-receipt text-3xl mb-2 text-slate-300"></i>
                <p class="text-sm">No recent transactions to display.</p>
              </div>
            <% } %>
          </div>
        </div>
        
      </div>
    </div>
    
    <div class="mt-12">
      <%- include('../../../views/partials/helper', { labHints, labObjective }) %>
    </div>
  </main>
  
</body>
</html>