<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard | <%= labName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/shared/style.css">
</head>
<body class="bg-gray-100 antialiased font-sans">
  <nav class="bg-gray-900 shadow-md p-4 flex justify-between items-center text-white sticky top-0 z-50">
    <h1 class="text-2xl font-bold tracking-tight"><%= labName %> Admin</h1>
    <div class="space-x-4 font-medium">
      <a href="/labs/socialsphere" class="hover:text-gray-300 transition-colors">Return to Site</a>
    </div>
  </nav>

  <main class="max-w-6xl mx-auto mt-6 grid grid-cols-1 md:grid-cols-4 gap-6 px-4">
    <!-- Left Sidebar -->
    <aside class="hidden md:block col-span-1">
      <div class="bg-white rounded-xl shadow-sm p-4 sticky top-24">
        <h2 class="text-lg font-bold text-gray-800 mb-4 border-b pb-2">Admin Menu</h2>
        <div class="space-y-2">
          <a href="#" class="flex items-center space-x-3 p-2 rounded-lg bg-blue-50 text-blue-700 font-medium transition-colors">
            <span>📊</span><span>Overview</span>
          </a>
          <a href="#" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-gray-50 text-gray-600 transition-colors">
            <span>👥</span><span>Users</span>
          </a>
          <a href="#" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-gray-50 text-gray-600 transition-colors">
            <span>🚩</span><span>Reports</span>
          </a>
          <a href="#" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-gray-50 text-gray-600 transition-colors">
            <span>🛡️</span><span>Moderation</span>
          </a>
          <a href="#" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-gray-50 text-gray-600 transition-colors">
            <span>⚙️</span><span>System Settings</span>
          </a>
        </div>
      </div>
    </aside>

    <!-- Center Content -->
    <section class="col-span-1 md:col-span-3 space-y-6">
      
      <!-- Flag / Completion Banner -->
      <% if (completed && completed.bacCompleted) { %>
        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded shadow-sm">
          <strong>✅ BAC Complete:</strong> You successfully bypassed access controls to reach the administrative panel! <br/>
          <span class="font-mono text-sm mt-2 block">FLAG: BAC_Completed</span>
        </div>
      <% } %>

      <!-- Overview Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <h3 class="text-gray-500 text-sm font-semibold uppercase tracking-wider">Total Users</h3>
          <p class="text-3xl font-bold text-gray-800 mt-2"><%= users.length %></p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <h3 class="text-gray-500 text-sm font-semibold uppercase tracking-wider">Active Reports</h3>
          <p class="text-3xl font-bold text-red-600 mt-2">12</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <h3 class="text-gray-500 text-sm font-semibold uppercase tracking-wider">System Status</h3>
          <p class="text-lg font-bold text-green-500 mt-2 flex items-center">
            <span class="w-3 h-3 bg-green-500 rounded-full mr-2"></span> Online
          </p>
        </div>
      </div>

      <!-- User Management Table -->
      <div class="bg-white rounded-xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center">
          <h2 class="text-lg font-bold text-gray-800">User Management</h2>
          <button class="bg-gray-900 hover:bg-gray-800 text-white px-3 py-1 rounded text-sm font-medium transition-colors">Export CSV</button>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-50 text-gray-600 text-sm border-b border-gray-100">
                <th class="py-3 px-6 font-semibold">ID</th>
                <th class="py-3 px-6 font-semibold">Name</th>
                <th class="py-3 px-6 font-semibold">Username</th>
                <th class="py-3 px-6 font-semibold">Role</th>
                <th class="py-3 px-6 font-semibold">Email (Private)</th>
                <th class="py-3 px-6 font-semibold text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% users.forEach(user => { %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="py-3 px-6 text-gray-500 font-mono text-sm"><%= user.id %></td>
                  <td class="py-3 px-6 font-medium text-gray-800"><%= user.name %></td>
                  <td class="py-3 px-6 text-gray-600">@<%= user.username %></td>
                  <td class="py-3 px-6">
                    <% if (user.role === 'admin') { %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">Admin</span>
                    <% } else { %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">User</span>
                    <% } %>
                  </td>
                  <td class="py-3 px-6 text-gray-500 text-sm"><%= user.private_email %></td>
                  <td class="py-3 px-6 text-right space-x-2">
                    <button class="text-blue-600 hover:text-blue-800 text-sm font-medium">Edit</button>
                    <button class="text-red-600 hover:text-red-800 text-sm font-medium">Ban</button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>

  <div class="max-w-6xl mx-auto px-4 mt-8">
    <%- include('../../../views/partials/helper') %>
  </div>
</body>
</html>
