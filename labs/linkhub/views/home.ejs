<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LinkHub | Link Management</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen font-sans text-gray-800">
  <nav class="bg-indigo-600 shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex items-center">
          <svg class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
          </svg>
          <span class="ml-2 text-xl font-bold text-white">LinkHub</span>
        </div>
        <div class="flex items-center space-x-4">
          <span class="text-indigo-100 text-sm">Welcome back, User</span>
          <img class="h-8 w-8 rounded-full" src="https://ui-avatars.com/api/?name=User&background=random" alt="User Avatar">
        </div>
      </div>
    </div>
  </nav>

  <main class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
    <div class="bg-white shadow rounded-lg p-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Your Tracked Links</h2>
      
      <p class="text-gray-600 mb-8">Manage your links and view analytics. All links are routed through our secure analytics tracker before redirecting to the destination.</p>

      <ul class="divide-y divide-gray-200">
        <li class="py-4 flex items-center justify-between">
          <div class="flex flex-col">
            <span class="text-sm font-medium text-gray-900">Campaign 2024 Promo</span>
            <span class="text-sm text-gray-500">https://example.com/promo-2024</span>
          </div>
          <div class="flex items-center space-x-3">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
              Active
            </span>
            <!-- Real link routing: /track -> external. Normal user clicks this. -->
            <a href="/labs/linkhub/track?target=https://example.com/promo-2024&campaign_id=9481" target="_blank" class="text-indigo-600 hover:text-indigo-900 text-sm font-medium">Test Link &rarr;</a>
          </div>
        </li>
        <li class="py-4 flex items-center justify-between">
          <div class="flex flex-col">
            <span class="text-sm font-medium text-gray-900">Partner Portal Login</span>
            <span class="text-sm text-gray-500">https://partners.local/login</span>
          </div>
          <div class="flex items-center space-x-3">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
              Paused
            </span>
            <a href="/labs/linkhub/track?target=https://partners.local/login&campaign_id=9482" target="_blank" class="text-indigo-600 hover:text-indigo-900 text-sm font-medium">Test Link &rarr;</a>
          </div>
        </li>
      </ul>

      <% if (completed) { %>
        <div class="mt-8 bg-green-50 border-l-4 border-green-400 p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm text-green-700 font-medium">Lab Completed! You exploited the Open Redirect vulnerability.</p>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </main>
  
  <div class="mt-12 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <%- include('../../../views/partials/helper') %>
  </div>
</body>
</html>