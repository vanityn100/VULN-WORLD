<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DropMart - Exclusive Drops</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-zinc-900 text-zinc-100 font-sans min-h-screen">

  <!-- Navbar -->
  <nav class="bg-black border-b border-zinc-800 sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex justify-between h-20 items-center">
        <div class="flex items-center space-x-2">
          <i class="fas fa-fire text-orange-500 text-3xl"></i>
          <span class="font-black text-2xl tracking-tighter uppercase">DropMart</span>
        </div>
        <div class="flex items-center space-x-6">
          <div class="text-sm">
            <span class="text-zinc-400">Purchased:</span>
            <span class="font-bold text-white ml-1 bg-zinc-800 px-3 py-1 rounded-full"><%= dropmart.purchased %></span>
          </div>
          <form action="/labs/dropmart/reset" method="POST">
            <button type="submit" class="text-sm text-zinc-400 hover:text-white transition uppercase font-bold tracking-wider">Reset</button>
          </form>
        </div>
      </div>
    </div>
  </nav>

  <main class="max-w-6xl mx-auto px-4 py-12">
    
    <% if (dropmart.completed) { %>
      <div class="bg-emerald-900/50 border border-emerald-500 text-emerald-100 p-6 mb-12 rounded-lg flex items-center shadow-lg shadow-emerald-900/20">
        <i class="fas fa-check-circle text-3xl text-emerald-400 mr-4"></i>
        <div>
          <h3 class="font-black text-xl uppercase tracking-wider mb-1">System Override Detected</h3>
          <p class="text-emerald-200/80">Lab Completed! You successfully exploited the race condition and bypassed the stock limits.</p>
        </div>
      </div>
    <% } %>

    <!-- Flash Drop Hero -->
    <div class="relative bg-zinc-800 rounded-2xl overflow-hidden shadow-2xl border border-zinc-700">
      
      <!-- Backdrop Graphic -->
      <div class="absolute inset-0 opacity-20">
        <div class="absolute inset-0 bg-gradient-to-r from-orange-600 to-purple-600 transform skew-y-12 scale-150"></div>
      </div>

      <div class="relative z-10 grid grid-cols-1 md:grid-cols-2 gap-8 p-8 md:p-12 items-center">
        
        <!-- Product Image -->
        <div class="flex justify-center">
          <div class="w-64 h-64 md:w-80 md:h-80 bg-zinc-900 rounded-full flex items-center justify-center border-4 border-zinc-800 shadow-[0_0_50px_rgba(249,115,22,0.15)] relative">
            <i class="fas fa-shoe-prints text-9xl text-zinc-700 transform -rotate-45"></i>
            <div class="absolute top-4 right-4 bg-orange-500 text-white text-xs font-black px-3 py-1 rounded-full uppercase tracking-widest rotate-12 shadow-lg">
              Limited
            </div>
          </div>
        </div>

        <!-- Product Details -->
        <div>
          <div class="inline-flex items-center space-x-2 bg-red-500/20 text-red-400 px-3 py-1 rounded-full text-sm font-bold mb-4 border border-red-500/30">
            <span class="animate-pulse w-2 h-2 rounded-full bg-red-500"></span>
            <span>Live Drop</span>
          </div>
          
          <h1 class="text-4xl md:text-5xl font-black uppercase tracking-tighter mb-2 leading-none text-white drop-shadow-md">
            X-Prime Velocity
          </h1>
          <h2 class="text-2xl text-zinc-400 font-bold mb-6">$299.00</h2>
          
          <p class="text-zinc-300 mb-8 leading-relaxed">
            The most highly anticipated drop of the year. Engineered with aerodynamic carbon-weave and hyper-responsive soles. Limit 1 per customer.
          </p>

          <div class="bg-zinc-900 p-6 rounded-xl border border-zinc-700 mb-8 flex justify-between items-center">
            <div>
              <p class="text-zinc-500 text-sm font-bold uppercase tracking-wider mb-1">Available Stock</p>
              <div class="flex items-end space-x-2">
                <span class="text-4xl font-black text-white leading-none"><%= stock %></span>
                <span class="text-zinc-500 mb-1">/ 1</span>
              </div>
            </div>
            <div class="text-right">
              <p class="text-zinc-500 text-sm font-bold uppercase tracking-wider mb-1">Status</p>
              <% if (stock > 0) { %>
                <span class="text-green-400 font-bold"><i class="fas fa-check mr-1"></i> In Stock</span>
              <% } else { %>
                <span class="text-red-500 font-bold"><i class="fas fa-times mr-1"></i> Sold Out</span>
              <% } %>
            </div>
          </div>

          <!-- Purchase Action -->
          <div class="relative">
            <form action="/labs/dropmart/buy" method="POST" id="buyForm">
              <% if (stock > 0) { %>
                <button type="submit" class="w-full bg-gradient-to-r from-orange-500 to-red-500 text-white py-4 px-8 rounded-xl font-black text-xl uppercase tracking-widest hover:from-orange-400 hover:to-red-400 transition-all transform hover:-translate-y-1 hover:shadow-[0_10px_40px_rgba(249,115,22,0.3)] active:scale-95 flex items-center justify-center group">
                  <i class="fas fa-bolt mr-3 group-hover:animate-bounce"></i>
                  Secure Your Pair
                </button>
              <% } else { %>
                <button type="button" disabled class="w-full bg-zinc-800 text-zinc-500 py-4 px-8 rounded-xl font-black text-xl uppercase tracking-widest cursor-not-allowed border border-zinc-700">
                  Drop Ended
                </button>
              <% } %>
            </form>
            
            <% if (typeof error !== 'undefined' && error) { %>
              <p class="text-red-500 text-sm mt-3 font-bold text-center"><i class="fas fa-exclamation-triangle"></i> <%= error %></p>
            <% } %>
          </div>
          
        </div>
      </div>
    </div>
    
    <div class="mt-16 bg-zinc-800 rounded-xl p-1 border border-zinc-700">
      <%- include('../../../views/partials/helper', { labHints, labObjective }) %>
    </div>
  </main>
  
</body>
</html>