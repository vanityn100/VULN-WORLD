<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>AccountHub - Profile Management</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 min-h-screen font-sans text-slate-800">
  <nav class="bg-indigo-600 text-white shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div class="flex items-center">
          <svg class="h-8 w-8 mr-2 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <span class="font-bold text-xl">AccountHub</span>
        </div>
        <div>
          <% if (loggedInUser) { %>
            <span class="mr-4">Welcome, <%= loggedInUser %></span>
            <form action="<%= resetPath %>" method="POST" class="inline">
              <button type="submit" class="bg-indigo-500 hover:bg-indigo-700 text-white px-3 py-1 rounded text-sm transition">Logout / Reset</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  </nav>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <% if (isCompleted) { %>
      <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-6 rounded shadow-sm" role="alert">
        <p class="font-bold">Admin Access Granted!</p>
        <p>You have successfully bypassed the authentication checks. FLAG: AccountHubPwned</p>
      </div>
    <% } %>

    <% if (loggedInUser) { %>
      <div class="bg-white shadow rounded-lg overflow-hidden border border-slate-200">
        <div class="px-6 py-5 border-b border-slate-200 bg-slate-50 flex justify-between items-center">
          <div>
            <h3 class="text-lg leading-6 font-medium text-slate-900">Personal Information</h3>
            <p class="mt-1 max-w-2xl text-sm text-slate-500">Update your account details and profile.</p>
          </div>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= role === 'admin' ? 'bg-red-100 text-red-800' : 'bg-blue-100 text-blue-800' %>">
            Role: <%= role %>
          </span>
        </div>
        <div class="px-6 py-5">
          <form action="/labs/accounthub/profile" method="POST" class="space-y-6">
            <div>
              <label for="email" class="block text-sm font-medium text-slate-700">Email Address</label>
              <input type="email" name="email" id="email" value="<%= userEmail %>" class="mt-1 block w-full px-3 py-2 border border-slate-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" required>
            </div>
            
            <div class="flex justify-end">
              <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                Save Changes
              </button>
            </div>
          </form>
        </div>
      </div>
    <% } else { %>
      <div class="max-w-md mx-auto bg-white p-8 rounded-lg shadow-md border border-slate-200 text-center">
        <h2 class="text-2xl font-bold text-slate-800 mb-4">Sign In</h2>
        <p class="text-slate-600 mb-8">Access your personalized AccountHub dashboard.</p>
        <form action="/labs/accounthub/login" method="POST">
          <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition">
            Continue with Default User
          </button>
        </form>
      </div>
    <% } %>

    <div class="mt-12">
      <%- include('../../../views/partials/helper') %>
    </div>
  </main>
</body>
</html>